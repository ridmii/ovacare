# Copy to backend/.env and fill in your values.

# Node.js booking API (port 5000)
PORT=5000
BOOKING_MONGODB_URI=mongodb://127.0.0.1:27017/ovacare
# Or use MongoDB Atlas:
# BOOKING_MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/ovacare

# Flask AI backend (port 5001 - scan upload, emails)
FLASK_PORT=5001
FLASK_API_URL=http://127.0.0.1:5001

# Flask
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=change-me
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MAX_CONTENT_LENGTH=16777216
UPLOAD_FOLDER=uploads

# ---------------------------------------------------------------------------
# SMTP — required for real emails (newsletter, booking confirmations)
# ---------------------------------------------------------------------------
#
# Gmail (recommended for development):
#   1. Sign in at https://myaccount.google.com/security
#   2. Turn on 2-Step Verification
#   3. Create an App Password: https://myaccount.google.com/apppasswords
#      (choose "Mail" and your device)
#   4. Paste the 16-character password below (spaces are OK — they are stripped)
#
# Outlook / Microsoft 365:
#   SMTP_HOST=smtp.office365.com
#   SMTP_PORT=587
#   SMTP_USE_TLS=true
#   SMTP_USE_SSL=false
#
# SendGrid (SMTP relay):
#   SMTP_HOST=smtp.sendgrid.net
#   SMTP_PORT=587
#   SMTP_USER=apikey
#   SMTP_PASSWORD=your_sendgrid_api_key
#
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_16_char_app_password
# If your app password contains spaces, wrap it in quotes:
# SMTP_PASSWORD="abcd efgh ijkl mnop"
SMTP_FROM=your_email@gmail.com
SMTP_FROM_NAME=OvaCare
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT=30
SMTP_TEST_RECIPIENT=your_email@gmail.com

# When false (default), email endpoints fail until SMTP is configured.
# When true and SMTP is missing, outbound emails are stored in MongoDB (sent_emails collection).
SMTP_SAVE_LOCALLY=false
